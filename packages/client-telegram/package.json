{
    "name": "@elizaos/client-telegram",
    "version": "0.1.7",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "@elizaos/source": "./src/index.ts",
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@elizaos/core": "workspace:*",
        "@telegraf/types": "7.1.0",
        "sharp": "0.33.5",
        "telegraf": "4.16.3",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "5.20260810.1",
        "tsup": "8.3.5"
    },
    "scripts": {
        "build": "tsup --format esm --dts && tsup src/standalone.ts --format esm --out-dir dist-standalone --clean --sourcemap",
        "build:standalone": "tsup src/standalone.ts --format esm --out-dir dist-standalone --clean --sourcemap",
        "build:worker": "pnpm dlx wrangler@4.120.0 deploy --dry-run --config wrangler.toml",
        "deploy:worker": "pnpm dlx wrangler@4.120.0 deploy --config wrangler.toml",
        "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
        "start:standalone": "node dist-standalone/standalone.js",
        "dev": "tsup --format esm --dts --watch",
        "lint": "eslint --fix  --cache ."
    }
}
